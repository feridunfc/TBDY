{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "metadata",
    "scope_items"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "catalog_name"
      ],
      "properties": {
        "contract": {
          "const": "Contract Constitution"
        },
        "version": {
          "const": "1.0"
        },
        "catalog_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scope_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_scope_id",
          "element_type",
          "status",
          "related_check_catalog_keys"
        ],
        "properties": {
          "status": {
            "enum": [
              "CONTRACTED",
              "BACKLOG",
              "DESIGN_CONTEXT",
              "MODEL_BASIS_AUDIT",
              "PENDING_ALIGNMENT"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
