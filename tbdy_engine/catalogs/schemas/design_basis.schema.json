    },
    "unit_system": {
      "type": "object"
    },
    "seismic_design_context": {
      "type": "object"
    },
    "model_assumptions": {
      "type": "object"
    },
    "element_design_policy": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
