    "metadata": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "catalog_name"
      ],
      "properties": {
        "contract": {
          "const": "Contract Constitution"
        },
        "version": {
          "const": "1.0"
        },
        "catalog_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tables": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": true
}
