{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check_preflight_diagnostic.schema.json",
  "title": "C13.3 Check Preflight Diagnostic",
  "type": "object",
  "required": [
    "diagnostic_contract_version",
    "diagnostic_only",
    "check_engine_invoked",
    "checks_locked",
    "safe_to_implement_checks_now",
    "check_unlock_allowed",
    "prospective_check_groups",
    "blockers"
  ],
  "properties": {
    "diagnostic_contract_version": {"type": "string"},
    "diagnostic_only": {"const": true},
    "check_engine_invoked": {"const": false},
    "checks_locked": {"const": true},
    "safe_to_implement_checks_now": {"const": false},
    "check_unlock_allowed": {"const": false},
    "prospective_check_groups": {"type": "array"},
    "blockers": {"type": "array"}
  },
  "additionalProperties": true
}
